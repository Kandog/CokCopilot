<?xml version="1.0" encoding="utf-8"?>
<!--
  CokCopilot behind IIS with HttpPlatformHandler (IIS starts and restarts the Python server).
  Edit the three paths below, then point an IIS site (with your HTTPS binding) at this folder.
  See docs/DEPLOY.md for the full steps.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <!-- processPath: the backend's Python.  -data-dir: where users, chats and settings are stored.
         The port comes from IIS automatically (HTTP_PLATFORM_PORT).
         -allowed-origin: the address users open in their browser / the desktop app. -->
    <httpPlatform processPath="C:\CokCopilot\backend\.venv\Scripts\python.exe"
                  arguments="-m cokcopilot serve --data-dir C:\CokCopilotData --allowed-origin https://chat.example.com"
                  startupTimeLimit="120"
                  requestTimeout="00:30:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\CokCopilotData\logs\iis-stdout">
      <environmentVariables>
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <environmentVariable name="COKCOPILOT_FRONTEND_DIST" value="C:\CokCopilot\frontend\dist" />
      </environmentVariables>
    </httpPlatform>

    <!-- Replies stream as Server-Sent Events; compression would hold them back. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <security>
      <requestFiltering>
        <!-- allow 25 MB attachments -->
        <requestLimits maxAllowedContentLength="30000000" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
