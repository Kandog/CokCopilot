{
  "mcpServers": {
    "search": {
      "type": "stdio",
      "command": "uvx",
      "args": [
	   "--system-certs",
	   "duckduckgo-mcp-server",
	   "--no-ssl-verify"
	   ],
      "disabledTools": [],
      "autoApprove": [
        "search",
        "fetch_content"
      ],
      "disabled": false
    },
    "fetch": {
      "type": "stdio",
      "command": "uv",
      "args": [
	    "run", "--no-project",
		"--with", "mcp-server-fetch",
		"--with", "truststore",
		"python", "-c",
		"import truststore; truststore.inject_into_ssl(); from mcp_server_fetch import main; main()",
		"--ignore-robots-txt"		
      ],
      "disabledTools": [],
      "autoApprove": [],
      "disabled": false
    }
  }
}